<!DOCTYPE html>
<html lang="en">
<%#
    Expects locals:
      pageTitle = 'Manage Users'
      user      = current session user (role: admin)
      users     = [{ user_id, username, email, role }, ...]
%>
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container">
        <h2 class="mb-4">Manage Users</h2>
        <%- include('../partials/alert') %>
        <div class="table-responsive">
            <table class="table table-bordered align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof users !== 'undefined' && users.length > 0) { %>
                        <% for (let i = 0; i < users.length; i++) { %>
                            <% const u = users[i]; %>
                            <tr>
                                <td><%= u.user_id %></td>
                                <td><%= u.username %></td>
                                <td><%= u.email %></td>
                                <td>
                                    <span class="badge <%= u.role === 'admin' ? 'bg-dark' : 'bg-secondary' %>"><%= u.role %></span>
                                </td>
                                <td>
                                    <%# HONG WEI: an admin cannot delete their own account, so hide the button on their own row %>
                                    <% if (u.user_id === user.user_id) { %>
                                        <span class="text-muted small">This is you</span>
                                    <%# Admins are peers - one admin must not be able to remove another.
                                        The server enforces this too; hiding the button is only the UI half. %>
                                    <% } else if (u.role === 'admin') { %>
                                        <span class="text-muted small">Admin account</span>
                                    <% } else { %>
                                        <%# Bootstrap modal instead of onsubmit="confirm(...)" - native confirm()
                                            can be silently suppressed by the browser after repeated dismissals,
                                            which makes the delete button look broken with no error at all. %>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal<%= u.user_id %>">
                                            Delete
                                        </button>

                                        <div class="modal fade" id="deleteUserModal<%= u.user_id %>" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Delete User</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Delete the account for "<%= u.username %>"? Their returned loan history will also be removed.
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form action="/admin/users/<%= u.user_id %>/delete" method="POST" class="d-inline">
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                </td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>
