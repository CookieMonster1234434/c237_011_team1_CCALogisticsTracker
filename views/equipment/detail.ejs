<!DOCTYPE html>
<html lang="en">
<%#
    Expects locals:
      pageTitle = equipment.name
      user      = current session user or null
      equipment = { equipment_id, name, category, description, image, total_quantity, available_quantity, condition }
      hasOverdueLoan = boolean (true if the logged-in student already has an overdue loan; blocks borrowing)
%>
<head>
    <%- include('../partials/head') %>
</head>
<body>
   
    <div class="container">
        <a href="/equipment" class="btn btn-link ps-0 mb-3"><i class="bi bi-arrow-left"></i> Back to Equipment</a>
        <%- include('../partials/alert') %>
        <div class="row g-4">
            <div class="col-md-5">
                <img src="<%= equipment.image ? '/uploads/' + equipment.image : '/images/placeholder.svg' %>"
                     class="img-fluid rounded shadow-sm" alt="<%= equipment.name %>">
            </div>
            <div class="col-md-7">
                <span class="badge bg-secondary mb-2"><%= equipment.category %></span>
                <h2><%= equipment.name %></h2>
                <p class="text-muted"><%= equipment.description %></p>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Available</span>
                        <strong><%= equipment.available_quantity %> / <%= equipment.total_quantity %></strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Condition</span>
                        <strong><%= equipment.condition %></strong>
                    </li>
                </ul>

                <% if (typeof user !== 'undefined' && user && user.role === 'student') { %>
                    <% if (typeof hasOverdueLoan !== 'undefined' && hasOverdueLoan) { %>
                        <div class="alert alert-warning">
                            You have an overdue item. Return it before borrowing more equipment.
                        </div>
                    <% } else if (equipment.available_quantity > 0) { %>
                        <a href="/equipment/<%= equipment.equipment_id %>/borrow" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-down"></i> Borrow this item
                        </a>
                    <% } else { %>
                        <button class="btn btn-secondary btn-lg" disabled>Currently Unavailable</button>
                    <% } %>
                <% } else if (typeof user === 'undefined' || !user) { %>
                    <a href="/login" class="btn btn-outline-primary">Login to borrow</a>
                <% } %>

                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <div class="mt-3 d-flex gap-2">
                        <a href="/admin/equipment/<%= equipment.equipment_id %>/edit" class="btn btn-outline-secondary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <%# Uses a Bootstrap modal instead of onsubmit="confirm(...)" - the native
                            confirm() dialog can be silently suppressed by the browser (e.g. Chrome's
                            "Prevent this page from creating additional dialogs"), which makes the
                            delete button look completely broken with no error of any kind. %>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteEquipmentModal">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>

                    <div class="modal fade" id="deleteEquipmentModal" tabindex="-1" aria-labelledby="deleteEquipmentModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteEquipmentModalLabel">Delete Equipment</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Delete "<%= equipment.name %>"? This cannot be undone.
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <form action="/admin/equipment/<%= equipment.equipment_id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>
