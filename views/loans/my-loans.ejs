<!DOCTYPE html>
<html lang="en">
<%#
    Expects locals:
      pageTitle = 'My Loans'
      user      = current session user
      loans     = [{ loan_id, equipment_id, name, borrow_date, due_date, return_date, status }, ...]
                   status is one of 'borrowed' | 'returned' | 'overdue'
%>
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="container">
        <%# Only offer the clear button when there is actually something to clear,
            so the student never clicks it and gets an error for nothing. %>
        <% const returnedCount = (typeof loans !== 'undefined' ? loans : []).filter(function (l) { return l.status === 'returned'; }).length; %>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">My Loans</h2>
            <% if (returnedCount > 0) { %>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#clearMyReturnedModal">
                    <i class="bi bi-trash3"></i> Clear Returned History (<%= returnedCount %>)
                </button>
            <% } %>
        </div>
        <%- include('../partials/alert') %>
        <div class="table-responsive">
            <table class="table table-bordered align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Equipment</th>
                        <th>Borrow Date</th>
                        <th>Due Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof loans !== 'undefined' && loans.length > 0) { %>
                        <% loans.forEach(function(loan) { %>
                            <tr class="<%= loan.status === 'overdue' ? 'table-row-overdue' : '' %>">
                                <td><a href="/equipment/<%= loan.equipment_id %>"><%= loan.name %></a></td>
                                <td><%= loan.borrow_date %></td>
                                <td><%= loan.due_date %></td>
                                <td><%= loan.return_date ? loan.return_date : '—' %></td>
                                <td>
                                    <span class="badge status-badge-<%= loan.status %>"><%= loan.status %></span>
                                </td>
                                <td>
                                    <% if (loan.status === 'borrowed' || loan.status === 'overdue') { %>
                                        <%# Expected action: POST /myloans/:id/return %>
                                        <form action="/myloans/<%= loan.loan_id %>/return" method="POST">
                                            <button type="submit" class="btn btn-sm btn-success">Return</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">You have no loans yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <% if (returnedCount > 0) { %>
        <div class="modal fade" id="clearMyReturnedModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Clear Returned History</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Remove <%= returnedCount %> returned loan record(s) from your history?
                        Anything you still have on loan will not be affected.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form action="/myloans/clear-returned" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-danger">Clear Returned History</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
    <%- include('../partials/footer') %>
</body>
</html>
